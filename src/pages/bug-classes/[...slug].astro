---
import { type CollectionEntry, getCollection } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import UAFAnimation from '../../components/UAFAnimation.astro';
import TcachePoisoning from '../../components/TcachePoisoning.astro';
import PlatformComparison from '../../components/PlatformComparison.astro';

export async function getStaticPaths() {
  const posts = await getCollection('bug-classes');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

type Props = CollectionEntry<'bug-classes'>;

const post = Astro.props;
const { Content } = await post.render();
---

<ContentLayout 
  title={post.data.title} 
  description={post.data.description}
  currentSlug={post.slug}
  collection="bug-classes"
>
  <!-- Header -->
  <div style="margin-bottom: 2rem;">
    <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap;">
      <span style={`padding: 0.25rem 0.6rem; border-radius: 4px; font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em; ${
        post.data.severity === 'critical' ? 'background: rgba(232,74,95,0.12); color: var(--danger);' :
        post.data.severity === 'high' ? 'background: rgba(240,160,48,0.12); color: var(--warning);' :
        'background: var(--bg-raised); color: var(--text-muted);'
      }`}>
        {post.data.severity}
      </span>
      {post.data.affected.heap && (
        <span style="padding: 0.25rem 0.6rem; background: var(--bg-raised); border-radius: 4px; font-size: 0.72rem; font-family: var(--font-mono); color: var(--text-muted);">heap</span>
      )}
      {post.data.affected.kernel && (
        <span style="padding: 0.25rem 0.6rem; background: var(--bg-raised); border-radius: 4px; font-size: 0.72rem; font-family: var(--font-mono); color: var(--text-muted);">kernel</span>
      )}
      {post.data.affected.userland && (
        <span style="padding: 0.25rem 0.6rem; background: var(--bg-raised); border-radius: 4px; font-size: 0.72rem; font-family: var(--font-mono); color: var(--text-muted);">userland</span>
      )}
    </div>
    <h1 style="margin-bottom: 0.75rem;">{post.data.title}</h1>
    <p style="font-size: 1.1rem; color: var(--text-body); margin: 0; max-width: 60ch;">{post.data.description}</p>
  </div>

  {post.data.prerequisites.length > 0 && (
    <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 8px; padding: 1.25rem; margin-bottom: 2rem;">
      <div style="font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 0.75rem;">Prerequisites</div>
      <ul style="margin: 0; padding-left: 1.25rem; color: var(--text-body);">
        {post.data.prerequisites.map(p => <li style="margin-bottom: 0.3rem;">{p}</li>)}
      </ul>
    </div>
  )}

  {/* UAF-specific interactive demos */}
  {post.slug === 'use-after-free' && (
    <div style="margin-bottom: 3rem;">
      <div style="font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 0.75rem;">Interactive Demo</div>
      <UAFAnimation />
    </div>
  )}

  <Content />

  {post.slug === 'use-after-free' && (
    <>
      <div style="margin-top: 3rem;">
        <div style="font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 0.75rem;">Tcache Poisoning Walkthrough</div>
        <TcachePoisoning />
      </div>

      <div style="margin-top: 3rem;">
        <div style="font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 0.75rem;">Platform Comparison</div>
        <PlatformComparison />
      </div>
    </>
  )}
</ContentLayout>
