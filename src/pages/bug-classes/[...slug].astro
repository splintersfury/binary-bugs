---
import { type CollectionEntry, getCollection } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import UAFAnimation from '../../components/UAFAnimation.astro';
import TcachePoisoning from '../../components/TcachePoisoning.astro';
import PlatformComparison from '../../components/PlatformComparison.astro';
import CharacterPortrait from '../../components/CharacterPortrait.astro';
import ComboCounter from '../../components/ComboCounter.astro';
import PowerUpBar from '../../components/PowerUpBar.astro';
import VSScreen from '../../components/VSScreen.astro';

export async function getStaticPaths() {
  const posts = await getCollection('bug-classes');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

type Props = CollectionEntry<'bug-classes'>;

const post = Astro.props;
const { Content } = await post.render();
---

<ContentLayout 
  title={post.data.title} 
  description={post.data.description}
  currentSlug={post.slug}
  collection="bug-classes"
>
  <!-- Header with anime character flair -->
  <div style="margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border);">
    <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap; align-items: center;">
      <span style={`padding: 0.3rem 0.7rem; border-radius: 4px; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; ${
        post.data.severity === 'critical' ? 'background: rgba(232,74,95,0.12); color: var(--danger); border: 1px solid rgba(232,74,95,0.25);' :
        post.data.severity === 'high' ? 'background: rgba(240,160,48,0.12); color: var(--warning); border: 1px solid rgba(240,160,48,0.25);' :
        'background: var(--bg-raised); color: var(--text-muted); border: 1px solid var(--border);'
      }`}>
        {post.data.severity}
      </span>
      {post.data.affected.heap && (
        <span style="padding: 0.3rem 0.6rem; background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; font-size: 0.72rem; font-family: var(--font-mono); color: var(--text-muted);">heap</span>
      )}
      {post.data.affected.kernel && (
        <span style="padding: 0.3rem 0.6rem; background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; font-size: 0.72rem; font-family: var(--font-mono); color: var(--text-muted);">kernel</span>
      )}
      {post.data.affected.userland && (
        <span style="padding: 0.3rem 0.6rem; background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; font-size: 0.72rem; font-family: var(--font-mono); color: var(--text-muted);">userland</span>
      )}
    </div>
    <h1 style="margin-bottom: 0.75rem; margin-top: 0;">{post.data.title}</h1>
    <p style="font-size: 1.1rem; color: var(--text-body); margin: 0; max-width: 60ch; line-height: 1.6;">{post.data.description}</p>
  </div>

  {post.data.prerequisites.length > 0 && (
    <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 8px; padding: 1.25rem; margin-bottom: 2.5rem;">
      <div style="font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 0.75rem;">Prerequisites</div>
      <ul style="margin: 0; padding-left: 1.25rem; color: var(--text-body);">
        {post.data.prerequisites.map(p => <li style="margin-bottom: 0.3rem;">{p}</li>)}
      </ul>
    </div>
  )}

  {/* UAF-specific interactive demos */}
  {post.slug === 'use-after-free' && (
    <div style="margin-bottom: 3rem;">
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
        <div style="width: 6px; height: 6px; border-radius: 50%; background: var(--accent); animation: pulse-dot 2s ease-in-out infinite;"></div>
        <div style="font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted);">Interactive Demo</div>
      </div>
      <UAFAnimation />
    </div>
  )}

  {/* Anime flair - Character battle for critical bugs */}
  {post.data.severity === 'critical' && (
    <div style="margin-bottom: 2.5rem; background: var(--bg-raised); border: 1px solid var(--border); border-radius: 8px; padding: 1.5rem;">
      <div style="display: flex; align-items: center; justify-content: center; gap: 2rem; flex-wrap: wrap;">
        <div style="text-align: center;">
          <CharacterPortrait character="attacker" size={64} />
          <div style="font-size: 0.7rem; color: var(--danger); font-weight: 700; margin-top: 0.5rem; text-transform: uppercase; letter-spacing: 0.05em;">Attacker</div>
        </div>
        <div style="font-size: 1.5rem; font-weight: 900; color: var(--danger); text-shadow: 2px 2px 0 var(--bg); animation: vs-bounce 2s ease-in-out infinite;">VS</div>
        <div style="text-align: center;">
          <CharacterPortrait character="defender" size={64} />
          <div style="font-size: 0.7rem; color: var(--success); font-weight: 700; margin-top: 0.5rem; text-transform: uppercase; letter-spacing: 0.05em;">System</div>
        </div>
      </div>
    </div>
  )}

  <div style="max-width: 70ch;">
    <Content />
  </div>

  {/* UAF-specific anime components */}
  {post.slug === 'use-after-free' && (
    <>
      {/* Exploitation Chain Combo */}
      <div style="margin: 2.5rem 0;">
        <ComboCounter steps={[
          { label: 'Allocate', icon: '📦', color: 'cyan' },
          { label: 'Free', icon: '🗑️', color: 'red' },
          { label: 'Realloc', icon: '🎯', color: 'amber' },
          { label: 'Exploit', icon: '⚡', color: 'green' },
        ]} />
      </div>

      {/* Difficulty Power-ups */}
      <div style="margin: 2.5rem 0; background: var(--bg-raised); border: 1px solid var(--border); border-radius: 8px; padding: 1.5rem;">
        <div style="font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 1rem;">Exploitation Difficulty</div>
        <PowerUpBar name="Reliability" level={85} maxLevel={100} color="green" description="High success rate with tcache poisoning" />
        <PowerUpBar name="Complexity" level={70} maxLevel={100} color="amber" description="Requires understanding of allocator internals" />
        <PowerUpBar name="Impact" level={95} maxLevel={100} color="red" description="Arbitrary code execution potential" />
      </div>

      <div style="margin-top: 3rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
          <div style="width: 6px; height: 6px; border-radius: 50%; background: var(--accent); animation: pulse-dot 2s ease-in-out infinite;"></div>
          <div style="font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted);">Tcache Poisoning Walkthrough</div>
        </div>
        <TcachePoisoning />
      </div>

      <div style="margin-top: 3rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
          <div style="width: 6px; height: 6px; border-radius: 50%; background: var(--accent); animation: pulse-dot 2s ease-in-out infinite;"></div>
          <div style="font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted);">Platform Comparison</div>
        </div>
        <PlatformComparison />
      </div>
    </>
  )}

  {/* VS Screen for platform battles */}
  {post.slug === 'use-after-free' && (
    <div style="margin-top: 3rem;">
      <VSScreen 
        leftName="Linux" 
        rightName="Windows" 
        leftColor="var(--accent)" 
        rightColor="var(--warning)" 
      />
    </div>
  )}

  <style>
    @keyframes pulse-dot {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(1.3); }
    }
    @keyframes vs-bounce {
      0%, 100% { transform: scale(1) rotate(-5deg); }
      50% { transform: scale(1.1) rotate(5deg); }
    }
  </style>
</ContentLayout>
