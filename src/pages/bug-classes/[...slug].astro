---
import { type CollectionEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('bug-classes');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

type Props = CollectionEntry<'bug-classes'>;

const post = Astro.props;
const { Content } = await post.render();

const allBugClasses = await getCollection('bug-classes');
---

<Layout title={post.data.title} description={post.data.description}>
  <div style="max-width: 1200px; margin: 0 auto; padding: 2rem; display: grid; grid-template-columns: 260px 1fr; gap: 2rem;">
    <aside style="border-right: 1px solid var(--border); padding-right: 1.5rem; align-self: start; position: sticky; top: 2rem;">
      <a href="/binary-bugs/" style="display: block; margin-bottom: 2rem; font-weight: 600;">← Binary Bugs</a>
      <h3 style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 1rem;">
        Bug Classes
      </h3>
      <ul style="list-style: none; padding: 0;">
        {allBugClasses.map(b => (
          <li style="margin-bottom: 0.5rem;">
            <a href={`/binary-bugs/bug-classes/${b.slug}`} 
               style={b.slug === post.slug ? 'color: var(--accent-hover); font-weight: 600;' : ''}>
              {b.data.title}
            </a>
          </li>
        ))}
      </ul>
    </aside>

    <main>
      <div style="margin-bottom: 1rem;">
        <span style={`display: inline-block; padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.75rem; text-transform: uppercase; font-weight: 600; ${
          post.data.severity === 'critical' ? 'background: rgba(248,81,73,0.2); color: var(--danger); border: 1px solid var(--danger);' :
          post.data.severity === 'high' ? 'background: rgba(240,136,62,0.2); color: var(--warning); border: 1px solid var(--warning);' :
          'background: var(--surface); color: var(--text-muted); border: 1px solid var(--border);'
        }`}>
          {post.data.severity}
        </span>
        {post.data.affected.heap && (
          <span style="display: inline-block; margin-left: 0.5rem; padding: 0.25rem 0.5rem; background: var(--surface); border: 1px solid var(--border); border-radius: 4px; font-size: 0.75rem; color: var(--text-muted);">heap</span>
        )}
        {post.data.affected.stack && (
          <span style="display: inline-block; margin-left: 0.5rem; padding: 0.25rem 0.5rem; background: var(--surface); border: 1px solid var(--border); border-radius: 4px; font-size: 0.75rem; color: var(--text-muted);">stack</span>
        )}
        {post.data.affected.kernel && (
          <span style="display: inline-block; margin-left: 0.5rem; padding: 0.25rem 0.5rem; background: var(--surface); border: 1px solid var(--border); border-radius: 4px; font-size: 0.75rem; color: var(--text-muted);">kernel</span>
        )}
      </div>

      <h1 style="margin-top: 0;">{post.data.title}</h1>
      <p style="color: var(--text-muted); font-size: 1.1rem; margin-bottom: 2rem;">{post.data.description}</p>

      {post.data.prerequisites.length > 0 && (
        <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 1rem; margin-bottom: 2rem;">
          <strong>Prerequisites:</strong>
          <ul style="margin: 0.5rem 0 0 1.5rem;">
            {post.data.prerequisites.map(p => <li>{p}</li>)}
          </ul>
        </div>
      )}

      <Content />
    </main>
  </div>
</Layout>
