---
import { type CollectionEntry, getCollection } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import UAFAnimation from '../../components/UAFAnimation.astro';
import TcachePoisoning from '../../components/TcachePoisoning.astro';
import PlatformComparison from '../../components/PlatformComparison.astro';

export async function getStaticPaths() {
  const posts = await getCollection('bug-classes');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

type Props = CollectionEntry<'bug-classes'>;

const post = Astro.props;
const { Content } = await post.render();
---

<ContentLayout 
  title={post.data.title} 
  description={post.data.description}
  currentSlug={post.slug}
  collection="bug-classes"
>
  <!-- Header -->
  <div style="margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border);">
    <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap; align-items: center;">
      <span style={`padding: 0.3rem 0.7rem; border-radius: 4px; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; ${
        post.data.severity === 'critical' ? 'background: rgba(232,74,95,0.12); color: var(--danger); border: 1px solid rgba(232,74,95,0.25);' :
        post.data.severity === 'high' ? 'background: rgba(240,160,48,0.12); color: var(--warning); border: 1px solid rgba(240,160,48,0.25);' :
        'background: var(--bg-raised); color: var(--text-muted); border: 1px solid var(--border);'
      }`}>
        {post.data.severity}
      </span>
      {post.data.affected.heap && (
        <span style="padding: 0.3rem 0.6rem; background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; font-size: 0.72rem; font-family: var(--font-mono); color: var(--text-muted);">heap</span>
      )}
      {post.data.affected.kernel && (
        <span style="padding: 0.3rem 0.6rem; background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; font-size: 0.72rem; font-family: var(--font-mono); color: var(--text-muted);">kernel</span>
      )}
      {post.data.affected.userland && (
        <span style="padding: 0.3rem 0.6rem; background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; font-size: 0.72rem; font-family: var(--font-mono); color: var(--text-muted);">userland</span>
      )}
    </div>
    <h1 class="anime-title" style="margin-bottom: 0.75rem; margin-top: 0;">{post.data.title}</h1>
    <p style="font-size: 1.1rem; color: var(--text-body); margin: 0; max-width: 60ch; line-height: 1.6;">{post.data.description}</p>
  </div>

  {post.data.prerequisites.length > 0 && (
    <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 8px; padding: 1.25rem; margin-bottom: 2.5rem;">
      <div style="font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 0.75rem;">Prerequisites</div>
      <ul style="margin: 0; padding-left: 1.25rem; color: var(--text-body);">
        {post.data.prerequisites.map(p => <li style="margin-bottom: 0.3rem;">{p}</li>)}
      </ul>
    </div>
  )}

  {/* UAF-specific interactive demos */}
  {post.slug === 'use-after-free' && (
    <div style="margin-bottom: 3rem;">
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
        <div class="pulse-dot"></div>
        <div style="font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted);">Interactive Demo</div>
      </div>
      <UAFAnimation />
    </div>
  )}

  <div class="anime-content" style="max-width: 70ch;">
    <Content />
  </div>

  {post.slug === 'use-after-free' && (
    <>
      <div style="margin-top: 3rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
          <div class="pulse-dot"></div>
          <div style="font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted);">Tcache Poisoning Walkthrough</div>
        </div>
        <TcachePoisoning />
      </div>

      <div style="margin-top: 3rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
          <div class="pulse-dot"></div>
          <div style="font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted);">Platform Comparison</div>
        </div>
        <PlatformComparison />
      </div>
    </>
  )}
</ContentLayout>

<style>
  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse-dot-anim 2s ease-in-out infinite;
  }
  
  @keyframes pulse-dot-anim {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.3); }
  }
  
  .anime-title {
    position: relative;
    animation: title-reveal 0.8s ease-out;
  }
  
  @keyframes title-reveal {
    0% { opacity: 0; transform: translateY(-10px); filter: blur(4px); }
    100% { opacity: 1; transform: translateY(0); filter: blur(0); }
  }
  
  .anime-content :global(h2) {
    position: relative;
    padding-left: 1rem;
    border-left: 3px solid var(--accent);
    animation: slide-in 0.6s ease-out;
  }
  
  @keyframes slide-in {
    0% { opacity: 0; transform: translateX(-20px); }
    100% { opacity: 1; transform: translateX(0); }
  }
  
  .anime-content :global(p) {
    animation: fade-up 0.5s ease-out;
    animation-fill-mode: both;
  }
  
  .anime-content :global(p:nth-child(1)) { animation-delay: 0.1s; }
  .anime-content :global(p:nth-child(2)) { animation-delay: 0.15s; }
  .anime-content :global(p:nth-child(3)) { animation-delay: 0.2s; }
  .anime-content :global(p:nth-child(4)) { animation-delay: 0.25s; }
  .anime-content :global(p:nth-child(5)) { animation-delay: 0.3s; }
  
  @keyframes fade-up {
    0% { opacity: 0; transform: translateY(8px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  
  .anime-content :global(pre) {
    position: relative;
    overflow: hidden;
  }
  
  .anime-content :global(pre::before) {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    animation: scanline 4s linear infinite;
    opacity: 0.5;
  }
  
  @keyframes scanline {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }
  
  .anime-content :global(code) {
    position: relative;
  }
  
  .anime-content :global(code::after) {
    content: '';
    position: absolute;
    inset: -2px;
    background: var(--accent-dim);
    border-radius: 3px;
    z-index: -1;
    opacity: 0;
    transition: opacity 0.3s;
  }
  
  .anime-content :global(code:hover::after) {
    opacity: 1;
  }
</style>
