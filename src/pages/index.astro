---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const fundamentals = await getCollection('fundamentals');
const bugClasses = await getCollection('bug-classes');
const caseStudies = await getCollection('case-studies');

const sortedFundamentals = fundamentals.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
---

<Layout title="Binary Bugs" description="Knowledge base for binary exploitation and memory corruption">
  
  <!-- Hero -->
  <div style="max-width: 800px; margin: 0 auto; padding: 4rem 1.5rem 3rem; text-align: center; position: relative;">
    <h1 class="hero-title" style="font-size: 3rem; font-weight: 800; margin-bottom: 1rem; letter-spacing: -0.03em; position: relative; display: inline-block;">
      Binary Bugs
    </h1>
    <p style="font-size: 1.25rem; color: var(--text-body); line-height: 1.6; margin: 0 auto 2rem; max-width: 55ch;">
      A structured knowledge base for understanding memory corruption, heap exploitation, and binary vulnerabilities. Built incrementally as I study.
    </p>
    <div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;">
      <a href="/binary-bugs/fundamentals/heap-overview" style="display: inline-block; padding: 0.6rem 1.25rem; background: var(--accent); color: var(--bg); font-weight: 600; border-radius: 6px; font-size: 0.95rem; text-decoration: none;">
        Start Learning
      </a>
      <a href="https://github.com/splintersfury/binary-bugs" target="_blank" style="display: inline-block; padding: 0.6rem 1.25rem; background: var(--bg-raised); border: 1px solid var(--border); color: var(--text-body); font-weight: 500; border-radius: 6px; font-size: 0.95rem; text-decoration: none;">
        View Source
      </a>
    </div>
  </div>

  <!-- Stats bar -->
  <div style="border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);">
    <div style="max-width: 800px; margin: 0 auto; padding: 1.25rem 1.5rem; display: flex; justify-content: center; gap: 3rem; flex-wrap: wrap;">
      <div style="text-align: center;">
        <div style="font-size: 1.5rem; font-weight: 700; color: var(--accent); font-family: var(--font-mono);">{fundamentals.length}</div>
        <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em;">Fundamentals</div>
      </div>
      <div style="text-align: center;">
        <div style="font-size: 1.5rem; font-weight: 700; color: var(--accent); font-family: var(--font-mono);">{bugClasses.length}</div>
        <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em;">Bug Classes</div>
      </div>
      <div style="text-align: center;">
        <div style="font-size: 1.5rem; font-weight: 700; color: var(--accent); font-family: var(--font-mono);">{caseStudies.length}</div>
        <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em;">Case Studies</div>
      </div>
    </div>
  </div>

  <!-- Content sections -->
  <div style="max-width: 800px; margin: 0 auto; padding: 3rem 1.5rem;">
    
    <!-- Fundamentals -->
    <section style="margin-bottom: 3rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
        <div style="width: 8px; height: 8px; border-radius: 50%; background: var(--accent);"></div>
        <h2 style="margin: 0; font-size: 1.1rem; border: none; padding: 0;">Fundamentals</h2>
        <span style="font-size: 0.75rem; color: var(--text-muted); font-family: var(--font-mono);">{fundamentals.length} topics</span>
      </div>
      <p style="color: var(--text-body); margin-bottom: 1rem; font-size: 0.95rem;">
        Platform-specific deep dives into memory allocators and virtual memory. These are prerequisites for understanding exploitation.
      </p>
      <div style="display: grid; gap: 0.5rem;">
        {sortedFundamentals.map(f => (
          <a href={`/binary-bugs/fundamentals/${f.slug}`} style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; background: var(--bg-raised); border: 1px solid var(--border); border-radius: 6px; text-decoration: none; color: var(--text); transition: all 0.15s;" class="card-link">
            <span style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted); min-width: 1.5rem;">{String(f.data.order).padStart(2, '0')}</span>
            <div>
              <div style="font-weight: 500; font-size: 0.92rem; margin-bottom: 0.15rem;">{f.data.title}</div>
              <div style="font-size: 0.8rem; color: var(--text-muted); line-height: 1.3;">{f.data.description}</div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Bug Classes -->
    <section style="margin-bottom: 3rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
        <div style="width: 8px; height: 8px; border-radius: 50%; background: var(--danger);"></div>
        <h2 style="margin: 0; font-size: 1.1rem; border: none; padding: 0;">Bug Classes</h2>
        <span style="font-size: 0.75rem; color: var(--text-muted); font-family: var(--font-mono);">{bugClasses.length} topics</span>
      </div>
      <p style="color: var(--text-body); margin-bottom: 1rem; font-size: 0.95rem;">
        Anatomy of memory corruption bugs: triggers, corrupted state, exploitation paths, and mitigations.
      </p>
      <div style="display: grid; gap: 0.5rem;">
        {bugClasses.map(b => (
          <a href={`/binary-bugs/bug-classes/${b.slug}`} style="display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 0.75rem 1rem; background: var(--bg-raised); border: 1px solid var(--border); border-radius: 6px; text-decoration: none; color: var(--text); transition: all 0.15s;" class="card-link">
            <div>
              <div style="font-weight: 500; font-size: 0.92rem; margin-bottom: 0.15rem;">{b.data.title}</div>
              <div style="font-size: 0.8rem; color: var(--text-muted); line-height: 1.3;">{b.data.description}</div>
            </div>
            <span style={`flex-shrink: 0; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.65rem; font-weight: 600; text-transform: uppercase; ${
              b.data.severity === 'critical' ? 'background: rgba(232,74,95,0.12); color: var(--danger);' :
              b.data.severity === 'high' ? 'background: rgba(240,160,48,0.12); color: var(--warning);' :
              'background: var(--bg-card); color: var(--text-muted);'
            }`}>
              {b.data.severity}
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Case Studies -->
    <section style="margin-bottom: 3rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
        <div style="width: 8px; height: 8px; border-radius: 50%; background: var(--success);"></div>
        <h2 style="margin: 0; font-size: 1.1rem; border: none; padding: 0;">Case Studies</h2>
        <span style="font-size: 0.75rem; color: var(--text-muted); font-family: var(--font-mono);">{caseStudies.length} topics</span>
      </div>
      <p style="color: var(--text-body); margin-bottom: 1rem; font-size: 0.95rem;">
        Real CVE write-ups and CTF challenge analyses. See how theory translates to real exploits.
      </p>
      {caseStudies.length > 0 ? (
        <div style="display: grid; gap: 0.5rem;">
          {caseStudies.map(c => (
            <a href={`/binary-bugs/case-studies/${c.slug}`} style="display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 0.75rem 1rem; background: var(--bg-raised); border: 1px solid var(--border); border-radius: 6px; text-decoration: none; color: var(--text); transition: all 0.15s;" class="card-link">
              <div>
                <div style="font-weight: 500; font-size: 0.92rem; margin-bottom: 0.15rem;">{c.data.title}</div>
                <div style="font-size: 0.8rem; color: var(--text-muted); line-height: 1.3;">{c.data.description}</div>
              </div>
              <span style="flex-shrink: 0; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.65rem; font-weight: 600; font-family: var(--font-mono); background: var(--accent-dim); color: var(--accent);">
                {c.data.cve}
              </span>
            </a>
          ))}
        </div>
      ) : (
        <p style="color: var(--text-muted); font-size: 0.9rem; font-style: italic;">Case studies coming soon.</p>
      )}
    </section>

    <!-- Philosophy -->
    <section style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--border);">
      <h2 style="font-size: 1.1rem; border: none; margin-bottom: 1.5rem;">How This Site Works</h2>
      <div style="display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
        <div>
          <h4 style="margin: 0 0 0.5rem; font-size: 0.8rem;">Platform-Agnostic</h4>
          <p style="font-size: 0.9rem; color: var(--text-body); margin: 0; line-height: 1.6;">
            Study both Linux (ptmalloc) and Windows (NT Heap). The concepts transfer. The details differ.
          </p>
        </div>
        <div>
          <h4 style="margin: 0 0 0.5rem; font-size: 0.8rem;">Incremental</h4>
          <p style="font-size: 0.9rem; color: var(--text-body); margin: 0; line-height: 1.6;">
            Start with fundamentals, then bug classes, then case studies. Each page links to its prerequisites.
          </p>
        </div>
        <div>
          <h4 style="margin: 0 0 0.5rem; font-size: 0.8rem;">Interactive</h4>
          <p style="font-size: 0.9rem; color: var(--text-body); margin: 0; line-height: 1.6;">
            Step through exploitation flows. Visualize allocator structures. Learn by doing, not just reading.
          </p>
        </div>
      </div>
    </section>
  </div>

  <style is:global>
    .card-link:hover {
      border-color: var(--border-hover) !important;
      background: var(--bg-card) !important;
      box-shadow: 0 4px 20px rgba(0, 224, 232, 0.05);
      transform: translateY(-2px);
    }
    
    .hero-title {
      animation: hero-glow 3s ease-in-out infinite alternate;
    }
    
    @keyframes hero-glow {
      0% { text-shadow: 0 0 20px rgba(0, 224, 232, 0.1); }
      100% { text-shadow: 0 0 40px rgba(0, 224, 232, 0.2), 0 0 80px rgba(0, 224, 232, 0.05); }
    }
  </style>
</Layout>
