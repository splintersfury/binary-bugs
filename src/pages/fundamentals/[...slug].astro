---
import { type CollectionEntry, getCollection } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import HeapDiagram from '../../components/HeapDiagram.astro';
import CharacterPortrait from '../../components/CharacterPortrait.astro';
import PowerUpBar from '../../components/PowerUpBar.astro';

export async function getStaticPaths() {
  const posts = await getCollection('fundamentals');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

type Props = CollectionEntry<'fundamentals'>;

const post = Astro.props;
const { Content } = await post.render();
---

<ContentLayout 
  title={post.data.title} 
  description={post.data.description}
  currentSlug={post.slug}
  collection="fundamentals"
>
  <div style="margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border);">
    <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap;">
      <span style="padding: 0.3rem 0.6rem; background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; font-size: 0.72rem; font-family: var(--font-mono); color: var(--text-muted); text-transform: uppercase;">
        {post.data.platform}
      </span>
      {post.data.tags.map(tag => (
        <span style="padding: 0.3rem 0.6rem; background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; font-size: 0.72rem; font-family: var(--font-mono); color: var(--text-muted);">
          {tag}
        </span>
      ))}
    </div>
    <h1 style="margin-bottom: 0.75rem; margin-top: 0;">{post.data.title}</h1>
    <p style="font-size: 1.1rem; color: var(--text-body); margin: 0; max-width: 60ch; line-height: 1.6;">{post.data.description}</p>
  </div>

  {post.slug === 'linux-ptmalloc' && (
    <div style="margin-bottom: 2.5rem;">
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
        <div style="width: 6px; height: 6px; border-radius: 50%; background: var(--accent); animation: pulse-dot 2s ease-in-out infinite;"></div>
        <div style="font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted);">Chunk Structure</div>
      </div>
      <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 8px; padding: 1.5rem;">
        <HeapDiagram />
      </div>
      <p style="text-align: center; font-size: 0.8rem; color: var(--text-muted); margin-top: 0.5rem;">Hover over sections for field descriptions</p>
    </div>
  )}

  {/* Anime flair - Allocator character */}
  <div style="margin-bottom: 2rem; display: flex; align-items: center; gap: 1rem; padding: 1rem; background: var(--bg-raised); border: 1px solid var(--border); border-radius: 8px;">
    <CharacterPortrait character="allocator" size={56} />
    <div>
      <div style="font-size: 0.8rem; font-weight: 700; color: var(--accent); margin-bottom: 0.25rem;">The Allocator</div>
      <div style="font-size: 0.8rem; color: var(--text-muted); line-height: 1.4;">Your opponent in the heap exploitation battle. Understand its behavior to defeat it.</div>
    </div>
  </div>

  <div style="max-width: 70ch;">
    <Content />
  </div>

  {/* Difficulty power-ups */}
  <div style="margin-top: 2.5rem; background: var(--bg-raised); border: 1px solid var(--border); border-radius: 8px; padding: 1.5rem;">
    <div style="font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 1rem;">Learning Curve</div>
    <PowerUpBar name="Concept Complexity" level={post.data.order ? post.data.order * 25 : 50} maxLevel={100} color="cyan" description="How difficult the concepts are to grasp" />
    <PowerUpBar name="Exploitation Potential" level={post.data.order ? post.data.order * 20 + 30 : 60} maxLevel={100} color="amber" description="How useful this knowledge is for exploitation" />
  </div>

  <style>
    @keyframes pulse-dot {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(1.3); }
    }
  </style>
</ContentLayout>
