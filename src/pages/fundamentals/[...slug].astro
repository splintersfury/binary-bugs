---
import { type CollectionEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('fundamentals');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

type Props = CollectionEntry<'fundamentals'>;

const post = Astro.props;
const { Content } = await post.render();

const allFundamentals = await getCollection('fundamentals');
const sorted = allFundamentals.sort((a, b) => a.data.order - b.data.order);
---

<Layout title={post.data.title} description={post.data.description}>
  <div style="max-width: 1200px; margin: 0 auto; padding: 2rem; display: grid; grid-template-columns: 260px 1fr; gap: 2rem;">
    <aside style="border-right: 1px solid var(--border); padding-right: 1.5rem; align-self: start; position: sticky; top: 2rem;">
      <a href="/binary-bugs/" style="display: block; margin-bottom: 2rem; font-weight: 600;">← Binary Bugs</a>
      <h3 style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 1rem;">
        Fundamentals
      </h3>
      <ul style="list-style: none; padding: 0;">
        {sorted.map(f => (
          <li style="margin-bottom: 0.5rem;">
            <a href={`/binary-bugs/fundamentals/${f.slug}`} 
               style={f.slug === post.slug ? 'color: var(--accent-hover); font-weight: 600;' : ''}>
              {f.data.title}
            </a>
          </li>
        ))}
      </ul>
    </aside>

    <main>
      <div style="margin-bottom: 1rem;">
        <span style="display: inline-block; padding: 0.25rem 0.5rem; background: var(--surface); border: 1px solid var(--border); border-radius: 4px; font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted);">
          {post.data.platform}
        </span>
        {post.data.tags.map(tag => (
          <span style="display: inline-block; margin-left: 0.5rem; padding: 0.25rem 0.5rem; background: var(--surface); border: 1px solid var(--border); border-radius: 4px; font-size: 0.75rem; color: var(--text-muted);">
            {tag}
          </span>
        ))}
      </div>
      <h1 style="margin-top: 0;">{post.data.title}</h1>
      <p style="color: var(--text-muted); font-size: 1.1rem; margin-bottom: 2rem;">{post.data.description}</p>
      <Content />
    </main>
  </div>
</Layout>
