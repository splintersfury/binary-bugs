---
import { type CollectionEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('case-studies');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

type Props = CollectionEntry<'case-studies'>;

const post = Astro.props;
const { Content } = await post.render();

const allCases = await getCollection('case-studies');
---

<Layout title={post.data.title} description={post.data.description}>
  <div style="max-width: 900px; margin: 0 auto; padding: 2rem 1.5rem;">
    
    <!-- Header -->
    <div style="text-align: center; margin-bottom: 3rem;">
      <div style="display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap; margin-bottom: 1.5rem;">
        <span style="display: inline-block; padding: 0.35rem 0.75rem; background: rgba(0,240,255,0.1); border: 1px solid rgba(0,240,255,0.2); border-radius: 4px; font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--accent);">
          {post.data.cve}
        </span>
        <span style="display: inline-block; padding: 0.35rem 0.75rem; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 4px; font-size: 0.75rem; font-family: var(--font-mono); color: var(--text-muted);">
          {post.data.platform}
        </span>
        {post.data.tags.map(tag => (
          <span style="display: inline-block; padding: 0.35rem 0.75rem; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 4px; font-size: 0.75rem; font-family: var(--font-mono); color: var(--text-muted);">
            {tag}
          </span>
        ))}
      </div>

      <h1 style="margin-top: 0; margin-bottom: 0.75rem; font-size: clamp(2rem, 5vw, 3.5rem);">{post.data.title}</h1>
      <p style="color: var(--text-secondary); font-size: 1.25rem; line-height: 1.6; max-width: 60ch; margin: 0 auto;">{post.data.description}</p>
    </div>

    {/* Link back to bug class */}
    {post.data.bugClass && (
      <div style="background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem; margin-bottom: 3rem; max-width: 500px; margin-left: auto; margin-right: auto; text-align: center;">
        <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 0.5rem;">Related Bug Class</div>
        <a href={`/binary-bugs/bug-classes/${post.data.bugClass.toLowerCase().replace(/\s+/g, '-')}`} 
           style="font-size: 1rem; color: var(--accent); font-weight: 700;">
          {post.data.bugClass} →
        </a>
      </div>
    )}

    {/* Content */}
    <div style="max-width: 70ch; margin: 0 auto;">
      <Content />
    </div>

    {/* Case study navigation */}
    {allCases.length > 1 && (
      <div style="margin-top: 3rem; margin-bottom: 2rem;">
        <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 1rem; text-align: center;">More Case Studies</div>
        <div style="display: flex; justify-content: center; gap: 0.5rem; flex-wrap: wrap;">
          {allCases.map(c => (
            <a href={`/binary-bugs/case-studies/${c.slug}`}
               style={`display: inline-block; padding: 0.5rem 1rem; border-radius: 6px; font-size: 0.85rem; transition: all 0.2s; text-decoration: none; ${c.slug === post.slug ? 'background: var(--accent-dim); color: var(--accent); border: 1px solid var(--accent); font-weight: 600;' : 'background: var(--bg-elevated); color: var(--text-secondary); border: 1px solid var(--border);'}`}>
              {c.data.cve}
            </a>
          ))}
        </div>
      </div>
    )}

    {/* Footer */}
    <div style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--border); text-align: center;">
      <a href="/binary-bugs/" style="display: inline-block; padding: 0.75rem 1.5rem; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 8px; font-weight: 600;">← Back to Binary Bugs</a>
    </div>
  </div>
</Layout>
