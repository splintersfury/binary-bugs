---
import { type CollectionEntry, getCollection } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('case-studies');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

type Props = CollectionEntry<'case-studies'>;

const post = Astro.props;
const { Content } = await post.render();
---

<ContentLayout 
  title={post.data.title} 
  description={post.data.description}
  currentSlug={post.slug}
  collection="case-studies"
>
  <div style="margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border);">
    <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap;">
      <span style="padding: 0.3rem 0.7rem; background: var(--accent-dim); border: 1px solid rgba(0,224,232,0.25); border-radius: 4px; font-size: 0.72rem; font-weight: 700; font-family: var(--font-mono); color: var(--accent); text-transform: uppercase; letter-spacing: 0.04em;">
        {post.data.cve}
      </span>
      <span style="padding: 0.3rem 0.6rem; background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; font-size: 0.72rem; font-family: var(--font-mono); color: var(--text-muted); text-transform: uppercase;">
        {post.data.platform}
      </span>
      {post.data.tags.map(tag => (
        <span style="padding: 0.3rem 0.6rem; background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; font-size: 0.72rem; font-family: var(--font-mono); color: var(--text-muted);">
          {tag}
        </span>
      ))}
    </div>
    <h1 class="anime-title" style="margin-bottom: 0.75rem; margin-top: 0;">{post.data.title}</h1>
    <p style="font-size: 1.1rem; color: var(--text-body); margin: 0; max-width: 60ch; line-height: 1.6;">{post.data.description}</p>
  </div>

  {post.data.bugClass && (
    <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 8px; padding: 1.25rem; margin-bottom: 2.5rem; display: flex; align-items: center; gap: 0.75rem;">
      <span style="font-size: 0.75rem; color: var(--text-muted);">Bug Class:</span>
      <a href={`/binary-bugs/bug-classes/${post.data.bugClass.toLowerCase().replace(/\s+/g, '-')}`} style="font-weight: 600; color: var(--accent); text-decoration: none;">
        {post.data.bugClass} →
      </a>
    </div>
  )}

  <div class="anime-content" style="max-width: 70ch;">
    <Content />
  </div>
</ContentLayout>

<style>
  .anime-title {
    animation: title-reveal 0.8s ease-out;
  }
  
  @keyframes title-reveal {
    0% { opacity: 0; transform: translateY(-10px); filter: blur(4px); }
    100% { opacity: 1; transform: translateY(0); filter: blur(0); }
  }
  
  .anime-content :global(h2) {
    position: relative;
    padding-left: 1rem;
    border-left: 3px solid var(--accent);
    animation: slide-in 0.6s ease-out;
  }
  
  @keyframes slide-in {
    0% { opacity: 0; transform: translateX(-20px); }
    100% { opacity: 1; transform: translateX(0); }
  }
  
  .anime-content :global(p) {
    animation: fade-up 0.5s ease-out;
    animation-fill-mode: both;
  }
  
  .anime-content :global(p:nth-child(1)) { animation-delay: 0.1s; }
  .anime-content :global(p:nth-child(2)) { animation-delay: 0.15s; }
  .anime-content :global(p:nth-child(3)) { animation-delay: 0.2s; }
  .anime-content :global(p:nth-child(4)) { animation-delay: 0.25s; }
  .anime-content :global(p:nth-child(5)) { animation-delay: 0.3s; }
  
  @keyframes fade-up {
    0% { opacity: 0; transform: translateY(8px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  
  .anime-content :global(pre) {
    position: relative;
    overflow: hidden;
  }
  
  .anime-content :global(pre::before) {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    animation: scanline 4s linear infinite;
    opacity: 0.5;
  }
  
  @keyframes scanline {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }
  
  .anime-content :global(code) {
    position: relative;
    transition: all 0.3s;
  }
  
  .anime-content :global(code:hover) {
    color: var(--accent);
  }
</style>
