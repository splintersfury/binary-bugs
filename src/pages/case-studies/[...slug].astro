---
import { type CollectionEntry, getCollection } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import CharacterPortrait from '../../components/CharacterPortrait.astro';
import ComboCounter from '../../components/ComboCounter.astro';
import PowerUpBar from '../../components/PowerUpBar.astro';

export async function getStaticPaths() {
  const posts = await getCollection('case-studies');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

type Props = CollectionEntry<'case-studies'>;

const post = Astro.props;
const { Content } = await post.render();
---

<ContentLayout 
  title={post.data.title} 
  description={post.data.description}
  currentSlug={post.slug}
  collection="case-studies"
>
  <div style="margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border);">
    <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap;">
      <span style="padding: 0.3rem 0.7rem; background: var(--accent-dim); border: 1px solid rgba(0,224,232,0.25); border-radius: 4px; font-size: 0.72rem; font-weight: 700; font-family: var(--font-mono); color: var(--accent); text-transform: uppercase; letter-spacing: 0.04em;">
        {post.data.cve}
      </span>
      <span style="padding: 0.3rem 0.6rem; background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; font-size: 0.72rem; font-family: var(--font-mono); color: var(--text-muted); text-transform: uppercase;">
        {post.data.platform}
      </span>
      {post.data.tags.map(tag => (
        <span style="padding: 0.3rem 0.6rem; background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; font-size: 0.72rem; font-family: var(--font-mono); color: var(--text-muted);">
          {tag}
        </span>
      ))}
    </div>
    <h1 style="margin-bottom: 0.75rem; margin-top: 0;">{post.data.title}</h1>
    <p style="font-size: 1.1rem; color: var(--text-body); margin: 0; max-width: 60ch; line-height: 1.6;">{post.data.description}</p>
  </div>

  {post.data.bugClass && (
    <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 8px; padding: 1.25rem; margin-bottom: 2.5rem; display: flex; align-items: center; gap: 0.75rem;">
      <span style="font-size: 0.75rem; color: var(--text-muted);">Bug Class:</span>
      <a href={`/binary-bugs/bug-classes/${post.data.bugClass.toLowerCase().replace(/\s+/g, '-')}`} style="font-weight: 600; color: var(--accent); text-decoration: none;">
        {post.data.bugClass} →
      </a>
    </div>
  )}

  {/* Hacker character for case studies */}
  <div style="margin-bottom: 2rem; display: flex; align-items: center; gap: 1rem; padding: 1rem; background: var(--bg-raised); border: 1px solid var(--border); border-radius: 8px;">
    <CharacterPortrait character="hacker" size={56} />
    <div>
      <div style="font-size: 0.8rem; font-weight: 700; color: var(--warning); margin-bottom: 0.25rem;">The Researcher</div>
      <div style="font-size: 0.8rem; color: var(--text-muted); line-height: 1.4;">Real-world exploitation requires patience, creativity, and deep understanding of the target.</div>
    </div>
  </div>

  <div style="max-width: 70ch;">
    <Content />
  </div>

  {/* Exploitation chain for case studies */}
  {post.data.bugClass && (
    <div style="margin-top: 2.5rem;">
      <ComboCounter steps={[
        { label: 'Vuln', icon: '🔍', color: 'cyan' },
        { label: 'Trigger', icon: '💥', color: 'red' },
        { label: 'Primitive', icon: '🔗', color: 'amber' },
        { label: 'Shell', icon: '🏆', color: 'green' },
      ]} />
    </div>
  )}

  {/* CVE Power levels */}
  <div style="margin-top: 2.5rem; background: var(--bg-raised); border: 1px solid var(--border); border-radius: 8px; padding: 1.5rem;">
    <div style="font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 1rem;">CVE Impact Analysis</div>
    <PowerUpBar name="Exploitability" level={90} maxLevel={100} color="red" description="How easy it is to exploit in the wild" />
    <PowerUpBar name="Impact" level={95} maxLevel={100} color="amber" description="Potential damage if exploited" />
    <PowerUpBar name="Patch Urgency" level={85} maxLevel={100} color="cyan" description="How quickly this needs to be patched" />
  </div>
</ContentLayout>
