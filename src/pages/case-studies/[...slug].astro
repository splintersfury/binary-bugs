---
import { type CollectionEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('case-studies');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

type Props = CollectionEntry<'case-studies'>;

const post = Astro.props;
const { Content } = await post.render();

const allCases = await getCollection('case-studies');
---

<Layout title={post.data.title} description={post.data.description}>
  <div style="max-width: 1200px; margin: 0 auto; padding: 2rem; display: grid; grid-template-columns: 260px 1fr; gap: 2rem;">
    <aside style="border-right: 1px solid var(--border); padding-right: 1.5rem; align-self: start; position: sticky; top: 2rem; height: fit-content;">
      <a href="/binary-bugs/" style="display: block; margin-bottom: 2rem; font-weight: 600; color: var(--text-secondary);">← Binary Bugs</a>
      <h3 style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 1rem; font-weight: 700;">
        Case Studies
      </h3>
      <ul style="list-style: none; padding: 0;">
        {allCases.map(c => (
          <li style="margin-bottom: 0.5rem;">
            <a href={`/binary-bugs/case-studies/${c.slug}`} 
               style={`display: block; padding: 0.35rem 0.5rem; border-radius: 6px; font-size: 0.85rem; transition: all 0.2s; ${c.slug === post.slug ? 'color: var(--accent); background: var(--accent-dim); font-weight: 600;' : 'color: var(--text-secondary);'}`}>
              <span style="display: inline-block; width: 1.5rem; font-family: var(--font-mono); font-size: 0.75rem; opacity: 0.5;">{c.data.cve}</span>
              {c.data.title}
            </a>
          </li>
        ))}
      </ul>
    </aside>

    <main>
      <div style="margin-bottom: 1.5rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <span style="display: inline-block; padding: 0.25rem 0.6rem; background: rgba(0,240,255,0.1); border: 1px solid rgba(0,240,255,0.2); border-radius: 4px; font-size: 0.7rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; color: var(--accent);">
          {post.data.cve}
        </span>
        <span style={`display: inline-block; padding: 0.25rem 0.6rem; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 4px; font-size: 0.7rem; font-family: var(--font-mono); color: var(--text-muted);`}>
          {post.data.platform}
        </span>
        {post.data.tags.map(tag => (
          <span style="display: inline-block; padding: 0.25rem 0.6rem; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 4px; font-size: 0.7rem; font-family: var(--font-mono); color: var(--text-muted);">
            {tag}
          </span>
        ))}
      </div>

      <h1 style="margin-top: 0; margin-bottom: 0.75rem;">{post.data.title}</h1>
      <p style="color: var(--text-secondary); font-size: 1.1rem; margin-bottom: 2.5rem; line-height: 1.6;">{post.data.description}</p>

      {/* Link back to bug class */}
      {post.data.bugClass && (
        <div style="background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 12px; padding: 1rem; margin-bottom: 2.5rem;">
          <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 0.5rem;">Related Bug Class</div>
          <a href={`/binary-bugs/bug-classes/${post.data.bugClass.toLowerCase().replace(/\s+/g, '-')}`} 
             style="font-size: 0.9rem; color: var(--accent); font-weight: 600;">
            {post.data.bugClass} →
          </a>
        </div>
      )}

      <Content />
    </main>
  </div>
</Layout>
