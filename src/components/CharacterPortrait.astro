---
interface Props {
  character: 'allocator' | 'attacker' | 'defender' | 'hacker';
  size?: number;
  class?: string;
}

const { character, size = 80, class: className = '' } = Astro.props;

const faces: Record<string, { color: string; eyeColor: string; expression: string }> = {
  allocator: { color: '#00f0ff', eyeColor: '#00f0ff', expression: 'neutral' },
  attacker: { color: '#ff4466', eyeColor: '#ff4466', expression: 'evil' },
  defender: { color: '#00ff9d', eyeColor: '#00ff9d', expression: 'alert' },
  hacker: { color: '#ffb800', eyeColor: '#ffb800', expression: 'focused' },
};

const f = faces[character];

// SVG paths for different expressions
const expressions: Record<string, { eyes: string; mouth: string; brows?: string }> = {
  neutral: {
    eyes: `<ellipse cx="35" cy="40" rx="8" ry="10" fill="${f.eyeColor}"/><ellipse cx="65" cy="40" rx="8" ry="10" fill="${f.eyeColor}"/><circle cx="37" cy="38" r="3" fill="#fff" opacity="0.8"/><circle cx="67" cy="38" r="3" fill="#fff" opacity="0.8"/>`,
    mouth: `<line x1="40" y1="65" x2="60" y2="65" stroke="${f.color}" stroke-width="2" stroke-linecap="round"/>`,
  },
  evil: {
    eyes: `<path d="M28 38 L42 42 L28 46 Z" fill="${f.eyeColor}"/><path d="M72 38 L58 42 L72 46 Z" fill="${f.eyeColor}"/>`,
    mouth: `<path d="M38 62 Q50 72 62 62" stroke="${f.color}" stroke-width="2.5" fill="none" stroke-linecap="round"/>`,
    brows: `<path d="M25 30 L45 34" stroke="${f.color}" stroke-width="2"/><path d="M75 30 L55 34" stroke="${f.color}" stroke-width="2"/>`,
  },
  alert: {
    eyes: `<circle cx="35" cy="42" r="9" fill="${f.eyeColor}"/><circle cx="65" cy="42" r="9" fill="${f.eyeColor}"/><circle cx="37" cy="40" r="3" fill="#fff" opacity="0.9"/><circle cx="67" cy="40" r="3" fill="#fff" opacity="0.9"/>`,
    mouth: `<circle cx="50" cy="66" r="5" fill="${f.color}"/>`,
    brows: `<path d="M28 28 L42 32" stroke="${f.color}" stroke-width="2"/><path d="M72 28 L58 32" stroke="${f.color}" stroke-width="2"/>`,
  },
  focused: {
    eyes: `<rect x="26" y="36" width="18" height="10" rx="2" fill="${f.eyeColor}"/><rect x="56" y="36" width="18" height="10" rx="2" fill="${f.eyeColor}"/><rect x="30" y="38" width="4" height="4" fill="#fff" opacity="0.9"/><rect x="60" y="38" width="4" height="4" fill="#fff" opacity="0.9"/>`,
    mouth: `<line x1="45" y1="64" x2="55" y2="64" stroke="${f.color}" stroke-width="2" stroke-linecap="round"/>`,
  },
};

const expr = expressions[f.expression];
---

<div class={`character-portrait ${className}`} style={`width: ${size}px; height: ${size}px; display: inline-block;`}>
  <svg viewBox="0 0 100 100" width={size} height={size} style="overflow: visible;">
    {/* Glow effect */}
    <circle cx="50" cy="50" r="48" fill="none" stroke={f.color} stroke-width="1" opacity="0.3">
      <animate attributeName="r" values="48;52;48" dur="2s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.3;0.1;0.3" dur="2s" repeatCount="indefinite"/>
    </circle>
    
    {/* Face background */}
    <circle cx="50" cy="50" r="45" fill="var(--bg-card)" stroke={f.color} stroke-width="3"/>
    
    {/* Inner shadow */}
    <circle cx="50" cy="50" r="42" fill="none" stroke={f.color} stroke-width="1" opacity="0.2"/>
    
    {/* Screen/face glow */}
    <ellipse cx="50" cy="45" rx="35" ry="30" fill={f.color} opacity="0.05"/>
    
    {/* Brows */}
    {expr.brows && <g set:html={expr.brows} />}
    
    {/* Eyes */}
    <g set:html={expr.eyes} />
    
    {/* Mouth */}
    <g set:html={expr.mouth} />
    
    {/* Tech details - circuit lines */}
    <line x1="15" y1="50" x2="5" y2="50" stroke={f.color} stroke-width="1" opacity="0.4"/>
    <line x1="85" y1="50" x2="95" y2="50" stroke={f.color} stroke-width="1" opacity="0.4"/>
    <circle cx="5" cy="50" r="2" fill={f.color} opacity="0.6">
      <animate attributeName="opacity" values="0.6;0.2;0.6" dur="1.5s" repeatCount="indefinite"/>
    </circle>
    <circle cx="95" cy="50" r="2" fill={f.color} opacity="0.6">
      <animate attributeName="opacity" values="0.6;0.2;0.6" dur="1.5s" repeatCount="indefinite" begin="0.75s"/>
    </circle>
  </svg>
</div>

<style>
  .character-portrait {
    filter: drop-shadow(0 0 10px currentColor);
    transition: transform 0.3s ease;
  }
  .character-portrait:hover {
    transform: scale(1.1);
  }
</style>
