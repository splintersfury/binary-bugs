---
interface Props {
  from: string;
  to: string;
  label?: string;
  class?: string;
}

const { from, to, label, class: className = "" } = Astro.props;
---

<div class={`relative flex items-center gap-4 ${className}`}>
  <div class="flex-1 text-right">
    <span class="text-sm font-mono text-[var(--text-secondary)]">{from}</span>
  </div>
  
  <div class="relative flex flex-col items-center">
    <div class="w-12 h-12 rounded-full bg-[var(--bg-card)] border-2 border-[var(--border)] flex items-center justify-center relative z-10 glow-border">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"/>
        <polyline points="12 5 19 12 12 19"/>
      </svg>
    </div>
    {label && (
      <span class="mt-2 text-xs font-mono text-[var(--accent)] whitespace-nowrap">{label}</span>
    )}
    
    <!-- Animated pulse ring -->
    <div class="absolute inset-0 rounded-full border-2 border-[var(--accent)] opacity-0" style="animation: pulse-ring 2s ease-out infinite;"></div>
  </div>
  
  <div class="flex-1">
    <span class="text-sm font-mono text-[var(--text)] font-semibold">{to}</span>
  </div>
</div>

<style>
  @keyframes pulse-ring {
    0% { transform: scale(1); opacity: 0.5; }
    100% { transform: scale(1.6); opacity: 0; }
  }
</style>
