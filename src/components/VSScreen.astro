---
interface Props {
  leftName: string;
  rightName: string;
  leftColor?: string;
  rightColor?: string;
  class?: string;
}

const { 
  leftName, 
  rightName, 
  leftColor = 'var(--accent)', 
  rightColor = 'var(--warning)',
  class: className = ''
} = Astro.props;
---

<div class={`vs-screen ${className}`} style="margin: 2rem 0; position: relative; overflow: hidden;">
  {/* Background flash */}
  <div class="vs-flash" style="position: absolute; inset: 0; background: radial-gradient(ellipse at center, rgba(255,255,255,0.1) 0%, transparent 70%); opacity: 0; z-index: 0;"></div>
  
  <div style="display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: center; position: relative; z-index: 1;">
    
    {/* Left fighter */}
    <div class="vs-fighter" style="text-align: center; padding: 1.5rem; background: var(--bg-card); border: 2px solid var(--border); border-radius: 8px; position: relative; overflow: hidden;">
      <div style={`position: absolute; top: 0; left: 0; right: 0; height: 4px; background: ${leftColor}; box-shadow: 0 0 20px ${leftColor};`}></div>
      <div style="font-size: 3rem; margin-bottom: 0.5rem;">🐧</div>
      <div style={`font-size: 1.2rem; font-weight: 800; color: ${leftColor}; text-transform: uppercase; letter-spacing: 0.1em;`}>{leftName}</div>
      <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">ptmalloc2</div>
    </div>
    
    {/* VS */}
    <div class="vs-text" style="text-align: center;">
      <div style="font-size: 2.5rem; font-weight: 900; color: var(--danger); text-shadow: 3px 3px 0 var(--bg), -2px -2px 0 var(--warning); line-height: 1; animation: vs-bounce 2s ease-in-out infinite;">VS</div>
    </div>
    
    {/* Right fighter */}
    <div class="vs-fighter" style="text-align: center; padding: 1.5rem; background: var(--bg-card); border: 2px solid var(--border); border-radius: 8px; position: relative; overflow: hidden;">
      <div style={`position: absolute; top: 0; left: 0; right: 0; height: 4px; background: ${rightColor}; box-shadow: 0 0 20px ${rightColor};`}></div>
      <div style="font-size: 3rem; margin-bottom: 0.5rem;">🪟</div>
      <div style={`font-size: 1.2rem; font-weight: 800; color: ${rightColor}; text-transform: uppercase; letter-spacing: 0.1em;`}>{rightName}</div>
      <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">NT Heap + LFH</div>
    </div>
  </div>
  
  {/* Versus clash lines */}
  <svg style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 100%; height: 100%; pointer-events: none; z-index: 2; opacity: 0.3;" viewBox="0 0 400 100" preserveAspectRatio="none">
    <line x1="0" y1="50" x2="180" y2="50" stroke="var(--danger)" stroke-width="2" stroke-dasharray="8,4">
      <animate attributeName="stroke-dashoffset" from="0" to="-24" dur="0.5s" repeatCount="indefinite"/>
    </line>
    <line x1="220" y1="50" x2="400" y2="50" stroke="var(--danger)" stroke-width="2" stroke-dasharray="8,4">
      <animate attributeName="stroke-dashoffset" from="0" to="-24" dur="0.5s" repeatCount="indefinite"/>
    </line>
    {/* Impact star */}
    <polygon points="195,45 200,35 205,45 215,50 205,55 200,65 195,55 185,50" fill="var(--warning)" opacity="0.8">
      <animateTransform attributeName="transform" type="scale" values="1;1.3;1" dur="1s" repeatCount="indefinite"/>
    </polygon>
  </svg>
</div>

<style>
  @keyframes vs-bounce {
    0%, 100% { transform: scale(1) rotate(-5deg); }
    50% { transform: scale(1.1) rotate(5deg); }
  }
  
  .vs-screen:hover .vs-flash {
    animation: vs-flash-anim 0.6s ease-out;
  }
  
  @keyframes vs-flash-anim {
    0% { opacity: 0; }
    50% { opacity: 1; }
    100% { opacity: 0; }
  }
  
  .vs-fighter {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .vs-fighter:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.3);
  }
</style>
