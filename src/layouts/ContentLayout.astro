---
import Layout from './Layout.astro';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description?: string;
  currentSlug: string;
  collection: 'fundamentals' | 'bug-classes' | 'case-studies';
}

const { title, description, currentSlug, collection } = Astro.props;

// Fetch items for sidebar
let items: { slug: string; title: string; subtitle?: string; order?: number }[] = [];

if (collection === 'fundamentals') {
  const docs = await getCollection('fundamentals');
  items = docs.sort((a, b) => (a.data.order || 0) - (b.data.order || 0)).map(d => ({
    slug: d.slug,
    title: d.data.title,
    subtitle: String(d.data.order || '').padStart(2, '0'),
  }));
} else if (collection === 'bug-classes') {
  const docs = await getCollection('bug-classes');
  items = docs.map(d => ({
    slug: d.slug,
    title: d.data.title,
    subtitle: d.data.severity,
  }));
} else if (collection === 'case-studies') {
  const docs = await getCollection('case-studies');
  items = docs.map(d => ({
    slug: d.slug,
    title: d.data.title,
    subtitle: d.data.cve,
  }));
}

const sectionLabels: Record<string, string> = {
  fundamentals: 'Fundamentals',
  'bug-classes': 'Bug Classes',
  'case-studies': 'Case Studies',
};
---

<Layout title={title} description={description}>
  <div style="max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem; display: grid; grid-template-columns: 240px 1fr; gap: 3rem;">
    
    <!-- Sidebar -->
    <aside style="align-self: start; position: sticky; top: 72px;">
      <a 
        href={`/binary-bugs/${collection}/`}
        style="display: block; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 1rem; text-decoration: none;"
      >
        {sectionLabels[collection]}
      </a>
      <nav style="display: flex; flex-direction: gap: 0.125rem;">
        {items.map(item => {
          const isActive = item.slug === currentSlug;
          const href = `/binary-bugs/${collection}/${item.slug}`;
          return (
            <a 
              href={href}
              style={`display: block; padding: 0.5rem 0.75rem; border-radius: 6px; font-size: 0.85rem; line-height: 1.4; text-decoration: none; transition: all 0.12s; margin-bottom: 2px; ${isActive ? 'background: var(--accent-dim); color: var(--accent); font-weight: 600;' : 'color: var(--text-body);'}`}
              class={isActive ? '' : 'sidebar-link'}
            >
              {item.subtitle && (
                <span style={`display: inline-block; font-family: var(--font-mono); font-size: 0.7rem; margin-right: 0.4rem; ${isActive ? 'color: var(--accent);' : 'color: var(--text-muted);'}`}>
                  {item.subtitle}
                </span>
              )}
              {item.title}
            </a>
          );
        })}
      </nav>
    </aside>

    <!-- Main Content -->
    <main style="min-width: 0;">
      <slot />
    </main>
  </div>

  <style is:global>
    .sidebar-link:hover {
      background: var(--bg-raised) !important;
      color: var(--text) !important;
    }
  </style>
</Layout>
